      "steg": [
        {
          "typ": "rum",
          "rumtyp": "strid",
          "text": "Valven långt under jord, där vattnet droppar. En efterlysning med era ansikten sitter spikad på väggen – 1000 guldmynt.",
          "fro": 297319818,
          "fiender": [
            "desertor",
            "desertor"
          ],
          "rutor": [
            38,
            51
          ],
          "klar": true,
          "utfallText": "Segern är er! Ni plundrar fienderna på 13 guld."
        },
        {
          "typ": "rum",
          "rumtyp": "skatt",
          "text": "Uppe på ringmuren, där vinden river i fanorna. Någon har ristat ett streck för varje dag på väggen – det är väldigt många streck. Vinden viner genom gluggarna.",
          "fro": 79319115,
          "klar": true,
          "utfallText": "Galfner Galfner hittar 24 guld och läkedryck."
        },
        {
          "typ": "rum",
          "rumtyp": "vila",
          "text": "Ringmuren vid ett halvt raserat vakttorn. Råttor har byggt bo i en gammal fångdräkt.",
          "fro": 602835815,
          "klar": true,
          "utfallText": "Ni går vidare utan att vila."
        },
        {
          "typ": "rum",
          "rumtyp": "hinder",
          "text": "Cellen ni själva satt i en gång – nummer sju. Ett porträtt av Kieslawski hänger snett, med alla medaljerna noga målade. Det är iskallt mellan stenväggarna.",
          "fro": 905454976,
          "hinder": {
            "namn": "En låst cell",
            "text": "Vägen går genom en låst cell. Någon stark måste bända upp gallret.",
            "fard": "STY",
            "alla": false,
            "skada": "T4",
            "miljo": [
              "fangelse"
            ]
          },
          "klar": true,
          "utfallText": "FF misslyckas och gör sig illa, men efter mycket svordomar tar ni er ändå förbi."
        },
        {
          "typ": "rum",
          "rumtyp": "boss",
          "text": "",
          "fro": 919268977,
          "fiender": [
            "kieslawski",
            "desertor"
          ],
          "rutor": [
            61,
            25
          ],
          "klar": true
        },
        {
          "typ": "rum",
          "rumtyp": "falla",
          "text": "Fängelsegården, där desertörerna slagit upp sina tält. Generalens svartröda fanor hänger överallt. Desertörer skrålar en sång om generalens storhet.",
          "fro": 431656633,
          "falla": {
            "namn": "Larmklocka",
            "text": "Någon trampar på en snubbeltråd och en larmklocka börjar ringa – armborstpilar viner genom gången.",
            "skada": "T6"
          },
          "klar": true,
          "utfallText": "Någon trampar på en snubbeltråd och en larmklocka börjar ringa – armborstpilar viner genom gången. Galfner Galfner får ta smällen."
        },
        {
          "typ": "rum",
          "rumtyp": "skatt",
          "text": "En cellgång där hälften av celldörrarna är utbrutna. Ett tärningsspel har avbrutits mitt i. Det luktar surt öl och gammal halm. Någon har ristat ”Bakhuvudet Jens var här” på väggen.",
          "fro": 947725974,
          "klar": true,
          "utfallText": "Galfner Galfner hittar 3 guld."
        },
        {
          "typ": "rum",
          "rumtyp": "strid",
          "text": "En underjordisk gång med igengallrade hål i golvet. En gammal fånge känner igen er och viskar att ni måste vara galna som kom tillbaka. En trumma slår långsamt någonstans uppe på gården.",
          "fro": 368422859,
          "fiender": [
            "stadsvakt",
            "desertor",
            "stadsvakt"
          ],
          "rutor": [
            43,
            31,
            48
          ],
          "klar": true,
          "utfallText": "Segern är er! Ni plundrar fienderna på 26 guld."
        },
        {
          "typ": "rum",
          "rumtyp": "hinder",
          "text": "En lång cellgång med rostiga galler på båda sidor. En vaktlista med en enda regel: ”Generalen har alltid rätt”. Det ekar när någon slår igen en järndörr.",
